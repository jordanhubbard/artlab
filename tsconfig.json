{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals",
      "vite/client"
    ]
  },
  "include": [
    "src/**/*.ts",
    "examples/**/*.ts",
    "bin/**/*.ts",
    "*.config.ts",
    "tests/contracts.ts",
    "tests/context.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "src/ide/IDE.ts",
    "src/ide/index.ts"
  ]
}
