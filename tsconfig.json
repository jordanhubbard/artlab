{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/runtime/contracts.d.ts", "src/runtime/SceneContext.ts", "tests/contracts.ts",
    "src/stdlib/math.ts", "src/stdlib/geometry.ts", "src/stdlib/lights.ts",
    "src/stdlib/sketch.ts", "src/stdlib/scene/**/*.ts",
    "src/physics/Physics.ts",
    "examples/physics-particles/physics-particles.ts",
    "examples/flocking-boids/flocking-boids.ts",
    "examples/hello-cube/hello-cube.ts",
    "examples/tutorial-01-geometry/tutorial-01-geometry.ts",
    "examples/tutorial-02-lights/tutorial-02-lights.ts",
    "examples/tutorial-03-animation/tutorial-03-animation.ts",
    "examples/tutorial-04-color/tutorial-04-color.ts",
    "examples/tutorial-05-interaction/tutorial-05-interaction.ts",
    "examples/interference-atlas/interference-atlas.ts",
    "examples/volume-observatory/volume-observatory.ts",
    "examples/wave-sculpture/wave-sculpture.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
