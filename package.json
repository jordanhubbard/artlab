{
  "name": "artlab",
  "version": "1.6.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "artlab": "bin/artlab.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:artlab": "BASE_URL=/artlab/ vite build",
    "test:e2e": "npm run build:artlab && playwright test",
    "typecheck": "npm run check:typescript && tsc --noEmit && tsc -p tsconfig.transpile.json",
    "check:typescript": "test -z \"$(git ls-files '*.js')\" && ! grep -R '\"entry\".*\\.js' examples/*/artlab.json"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@rollup/browser": "^4.63.3",
    "jszip": "^3.10.1",
    "manifold-3d": "^3.4.1",
    "monaco-editor": "^0.53.0",
    "three": "^0.170.0",
    "tone": "^14.9.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/three": "0.170.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.0.2",
    "pngjs": "7.0.0",
    "rollup": "^4.63.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
